app-id: net.froemling.bombsquad
runtime: org.freedesktop.Platform
runtime-version: "26.08"
sdk: org.freedesktop.Sdk
command: bombsquad.sh
finish-args:
  - --share=network
  - --share=ipc
  - --socket=x11
  - --socket=pulseaudio
  - --device=dri
  # - --device=input
  - --persist=.ballisticakit

sdk-extensions:
  - org.freedesktop.Sdk.Extension.llvm22

modules:
  # rsync is not in the SDK, and the build system requires it: pcommand
  # checkenv insists on it, and the staging steps use it to assemble
  # build/cmake/*/staged. It is built from a pinned source archive,
  # which works offline -- flatpak-builder fetches declared sources
  # outside the build sandbox -- and cleaned out of the finished app.
  # Listed first because it never changes: flatpak-builder rebuilds
  # every module after one that does (python-build-env, on any lock
  # bump).
  - name: rsync
    buildsystem: autotools
    config-opts:
      - --prefix=${FLATPAK_DEST}
      - --disable-debug
      - --disable-locale
    sources:
      - type: archive
        url: https://download.samba.org/pub/rsync/src/rsync-3.5.1.tar.gz
        sha256: c55f9c9dc10fb8bec397b399a0fdded53cc9a2d8e30891bb0d63724d25c37bef
    cleanup:
      - "*"

  # uv plus a wheel for every package in
  # pconfig/requirements_build_lock.txt, so the module below can create
  # the project venv with no network access. Generated from our
  # lockfile by `make flatpak-build-env`; do not edit by hand.
  - python-build-env.yml

  # org.freedesktop.Sdk 26.08 provides the python3.14 bombsquad
  # requires. If we ever have to target a runtime that is behind,
  # enable this module to build the required python locally; nothing
  # else needs changing, since /app/bin precedes /usr/bin on the build
  # PATH and uv will pick that interpreter up when creating the venv.

  # - name: Python
  #   sources:
  #     - type: archive
  #       url: https://www.python.org/ftp/python/3.13.3/Python-3.13.3.tar.xz
  #       sha256: 40f868bcbdeb8149a3149580bb9bfd407b3321cd48f0be631af955ac92c0e041
  #   config-opts:
  #     - --prefix=${FLATPAK_DEST}
  #     - --enable-shared
  #     - --enable-optimizations
  #     - --with-computed-gotos
  #     - --with-lto
  #     - --enable-ipv6
  #     - --with-system-expat
  #     - --with-system-ffi
  #     - --with-system-libmpdec
  #     - --enable-loadable-sqlite-extensions
  #     - --without-ensurepip
  #   cleanup:
  #     - /bin
  #     - /include
  #     - /lib/pkgconfig
  #     - /share

  # SDL2 is already provided by the runtime

  # - name: SDL2
  #   buildsystem: cmake
  #   builddir: true
  #   cleanup:
  #     - /bin
  #     - /include
  #     - /lib/pkgconfig
  #     - /lib/cmake
  #     - /share
  #     - "*.a"
  #   sources:
  #     - type: git
  #       url: https://github.com/libsdl-org/SDL
  #       tag: release-2.32.8

  - name: bombsquad
    buildsystem: simple
    build-options:
      append-path: /usr/lib/sdk/llvm22/bin
      prepend-ld-library-path: /usr/lib/sdk/llvm22/lib
      build-args:
        - --share=network
      env:
        CMAKE_BUILD_TYPE: "Release"
        # Build the project venv in the sandbox, offline, from the wheels
        # the python-build-env module staged (see
        # tools/batools/flatpakbuildenv.py for why it can't come from
        # the host).
        VENV_LOCK: pconfig/requirements_build_lock.txt
        UV_OFFLINE: "1"
        UV_FIND_LINKS: /app/share/python-build-env/wheels
        UV_PYTHON_DOWNLOADS: never
        UV_CACHE_DIR: .cache/uv
    build-commands:
      # FLATPAK_DEST=/app, FLATPAK_ID=net.froemling.bombsquad
      - mkdir -p ${FLATPAK_DEST}/bin/bombsquad
      # The source archive carries no .venv, so this creates one from
      # scratch against the runtime's python3.14 and installs into it
      # from the staged wheels. The generated tools/pcommand and
      # friends carry the release builder's shebangs, so clear them out
      # first and let `make env` regenerate them for this venv.
      - make env-clean
      - make cmake-build
      - mv build/cmake/*/ballisticakit build/cmake/*/staged/
      - cp -r build/cmake/*/staged/* ${FLATPAK_DEST}/bin/bombsquad/
      - install -Dm755 bombsquad.sh ${FLATPAK_DEST}/bin/bombsquad.sh
      - install -Dm644 pconfig/flatpak/net.froemling.bombsquad.desktop ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop
      - install -Dm644 pconfig/flatpak/net.froemling.bombsquad.metainfo.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml
      - install -Dm644 pconfig/flatpak/net.froemling.bombsquad.releases.xml ${FLATPAK_DEST}/share/metainfo/releases/${FLATPAK_ID}.releases.xml
      - install -Dm644 ${FLATPAK_ID}.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/${FLATPAK_ID}.png

    sources:
      # - type: dir
      #   path: ./../../

      - type: archive
        url: { ARCHIVE_URL }
        sha256: { SHA256_CHECKSUM }
        strip-components: 0

      - type: file
        dest-filename: net.froemling.bombsquad.png
        url: https://files.ballistica.net/bombsquad/promo/BombSquadIcon512.png
        sha256: c950d1b62da2714b1ed1afc42244f7e192be23172c89b6fa3e6eaaca8e45a89a

      - type: script
        dest-filename: bombsquad.sh
        commands:
          - cd /app/bin/bombsquad
          - exec ./ballisticakit
